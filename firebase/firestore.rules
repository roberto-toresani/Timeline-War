rules_version = '2';

// Da incollare in Firebase Console -> Firestore Database -> Regole, poi Pubblica.
// Chiunque puo' leggere lo stato della partita (mappa condivisa in sola lettura),
// ma solo l'account con lo stesso UID indicato qui sotto puo' scriverlo.
// Sostituisci ADMIN_UID_QUI con l'UID del tuo utente admin
// (Firebase Console -> Authentication -> Users -> colonna "User UID"),
// lo stesso valore va messo anche in ADMIN_UID dentro firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    // Stato di gioco condiviso. Scrittura APERTA a tutti (regola dell'utente): in
    // una partita multi-giocatore ogni player gioca dal proprio browser e deve
    // poter scrivere le sue mosse (schiera/costruisci/attacca/fine turno). Le
    // regole di turno e fase sono validate lato client (game-actions.js): un
    // giocatore agisce solo nel suo turno. Il compromesso e' la sicurezza — chi ha
    // un link potrebbe in teoria riscrivere lo stato — accettabile tra persone
    // conosciute (i codici invito gia' non sono segreti). L'UID admin resta usato
    // solo per i PERMESSI lato client (chi muove i bot, chi vede l'editor), non
    // piu' per l'enforcement della scrittura.
    match /games/main {
      allow read: if true;
      allow write: if true;
    }

    // BACKUP PER TURNO (sottocollezione games/main/turns/{turno}): all'inizio di
    // ogni decennio si salva l'intero stato in un documento a parte, cosi' si puo'
    // sempre ricaricare la partita da un turno precedente se qualcosa la danneggia
    // (regola dell'utente). Come lo stato principale, letta/scritta da tutti: ogni
    // browser scrive il backup del turno dal proprio client. Una regola su
    // games/main NON copre le sue sottocollezioni: senza questa i backup fallirebbero
    // in silenzio.
    match /games/main/turns/{turno} {
      allow read: if true;
      allow write: if true;
    }

    // Presenza dei giocatori: quale regno ha "preso" un giocatore aprendo il suo
    // link d'invito. NON e' stato di gioco autorevole (quello resta in games/main,
    // scrivibile solo dall'admin): serve solo perche' l'editor dell'admin mostri
    // che un regno sara' giocato da una persona e non da lui. Percio' e' scrivibile
    // da chiunque (un giocatore invitato non e' autenticato come admin), un
    // documento per codice d'invito.
    match /presence/{code} {
      allow read: if true;
      allow write: if true;
    }

    // Chat fra i giocatori (un documento per messaggio): come la presenza, NON e'
    // stato di gioco autorevole, serve solo a farli chiacchierare durante le lunghe
    // attese fra un turno e l'altro. Percio' e' aperta in lettura/scrittura a tutti
    // (ogni player scrive dal proprio browser, non e' admin). Un messaggio privato
    // porta un campo `to` col nome del regno destinatario: e' un filtro lato client,
    // non un segreto crittografico (chi ha accesso al database vede tutto).
    match /chat/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
