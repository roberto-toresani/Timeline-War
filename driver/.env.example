# Copia questo file in ".env" (stessa cartella) e riempilo coi valori veri.
# Il file ".env" NON va committato (è già in .gitignore): contiene la password.

# Credenziali dell'account ADMIN: le STESSE con cui fai "Accesso admin" nell'editor.
ADMIN_EMAIL=tuo-admin@example.com
ADMIN_PASSWORD=la-tua-password-admin

# Pagina da pilotare. Di norma l'editor del sito live; cambiala solo se serve.
GAME_URL=https://roberto-toresani.github.io/Timeline-War/index.html

# ---------- SISTEMA MAIL (regola dell'utente) ----------
# Quando il turno passa a un giocatore umano il driver gli manda una mail
# personalizzata col link della plancia e due scorciatoie di auto-schieramento.
# Se lasci vuote queste variabili il driver gira lo stesso, ma non manda mail.
#
# Consigliato: un account Gmail dedicato (es. risiko-motore@gmail.com) con
# APP-PASSWORD (Sicurezza → Password per le app nel Google Account — NON la
# password di login). 500 mail/giorno bastano ampiamente per la partita.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=risiko-motore@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="Risiko Online <risiko-motore@gmail.com>"

# Base URL della PLANCIA usata nei link della mail. Deve puntare a play.html
# del sito che i giocatori aprono davvero (di norma la stessa origine di GAME_URL).
# Il codice d'invito viene appeso da solo: PLAY_BASE_URL + "?p=CODICE".
PLAY_BASE_URL=https://roberto-toresani.github.io/Timeline-War/play.html

# Quante ore per giocare il turno prima che il motore lo chiuda d'ufficio.
# Regola dell'utente: 6 ore. Cambiala solo se davvero necessario — il numero
# è anche scritto nel testo della mail e nel timer della plancia.
TURN_DEADLINE_HOURS=6
